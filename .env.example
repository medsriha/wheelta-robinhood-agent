# .env.example — the source of truth for every environment variable.
# Copy to .env for local development (gitignored). In Railway, set these as service variables.
# [secret] = never commit, never log. Defaults shown are the SAFE defaults.
# Read once at startup by config/settings.py; nothing else reads the environment.
# [required] = the run aborts before any network call if it is missing or blank.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local                         # local | production (Railway is production only, ADR-0024). Live runs only in production; local is always a dry run, on demand with --run-now (ADR-0039). staging is accepted but unused
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
RUN_TIMEOUT_SECONDS=2400              # whole-tick budget (both agents, ADR-0057); must be below 3600 s, the fallback run cadence (validated; ADR-0028)
CLOSE_AGENT_TIMEOUT_SECONDS=900       # the Buy-to-Close agent's budget within the tick; the Sell Options agent gets the rest. Must exceed 240 s and leave more than 240 s for the Sell agent (validated; ADR-0057)

# ── Safety controls (read from env + code only; never from LLM, tools, or DB) ─
EXECUTION_MODE=off                    # off (dry run, on demand with --run-now; the live order tools go to an in-process simulated broker, ADR-0038) | live — unknown values are treated as off
EXECUTION_ARMED=false                 # must be true with EXECUTION_MODE=live; then the agent places orders with NO human approval (ADR-0006)
KILL_SWITCH=false                     # startup-only stop; true prevents a run. SIGTERM/SIGINT sets the separate runtime stop latch (ADR-0010)

# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # [secret] [required]
AGENT_MODEL=                          # [required] exact model ID, pinned; recorded on every run. May end in [1m] (Claude Code 1M-context window, ADR-0036), e.g. claude-opus-5-5[1m]; the summary email and Mignon fallback use the ID without it
MIGNON_AGENT_MODELS=                  # [optional] comma-separated exact model IDs the orchestrator may assign to each Mignon (ADR-0025); unset or blank = AGENT_MODEL only; aliases (opus, sonnet, inherit) rejected
MCP_TIMEOUT=30000                     # ms, MCP server connect timeout (Agent SDK)
MCP_TOOL_TIMEOUT=60000                # ms, per MCP tool call timeout (Agent SDK); must exceed 10000: the validating proxy answers 10 s earlier (ADR-0023)

# ── Robinhood Trading MCP ────────────────────────────────────────────────────
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
LOCAL_ACCEPT_REMOTE_RESULT_RISK=false  # local dry runs only (APP_ENV=local): lets remote MCP tools reach the model before all result-boundary tests pass (ADR-0019)
ROBINHOOD_MCP_AUTH=token              # token | claude_code_login | refresh_token. claude_code_login: local only (APP_ENV=local), reuses the Claude Code /mcp login for the `robinhood` server; excludes a token (ADR-0018). refresh_token: any APP_ENV; the run refreshes an encrypted, rotating OAuth pair kept in the ledger (seed it first: python -m wheelta_robinhood_agent.orchestrator.seed_robinhood_credential); requires ROBINHOOD_TOKEN_ENCRYPTION_KEY, excludes ROBINHOOD_MCP_ACCESS_TOKEN (ADR-0021)
ROBINHOOD_MCP_ACCESS_TOKEN=           # [secret] optional; used only when ROBINHOOD_MCP_AUTH=token (a static bearer token). Absent → Robinhood unavailable (needs-auth)
ROBINHOOD_TOKEN_ENCRYPTION_KEY=       # [secret] required with ROBINHOOD_MCP_AUTH=refresh_token, rejected otherwise. Fernet key encrypting the ledger's oauth_credentials (ADR-0021). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())". One key per environment; losing it means re-seeding
# Seed-only (ADR-0021): written by scripts/robinhood_oauth_probe.py after a browser login and read only by
# `python -m wheelta_robinhood_agent.orchestrator.seed_robinhood_credential --env-file .env`. The agent never reads them.
# Refresh tokens rotate: after the first refresh these are stale; the ledger row is the source of truth. Re-seeding needs a fresh login.
ROBINHOOD_OAUTH_CLIENT_ID=            # seed-only; the dynamically registered public OAuth client id
ROBINHOOD_OAUTH_ACCESS_TOKEN=         # [secret] seed-only
ROBINHOOD_OAUTH_REFRESH_TOKEN=        # [secret] seed-only; rotates on every refresh, never reuse an old one
ROBINHOOD_OAUTH_OBTAINED_AT=          # seed-only; ISO 8601 UTC time the pair was obtained (e.g. 2026-09-26T15:00:00+00:00)
ROBINHOOD_OAUTH_EXPIRES_IN=           # seed-only; access-token lifetime in seconds from the token response
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=     # [secret-ish] [required] the only account the agent may act on; logged as last 4 only
ROBINHOOD_WORKSPACE_WRITES=true       # Tier S (watchlists/scans/alerts) on owned objects; false withholds the write tools
ROBINHOOD_WORKSPACE_PREFIX="WRA · "   # name prefix marking agent-owned watchlists/scans/alerts

# ── Wheelta MCP ──────────────────────────────────────────────────────────────
WHEELTA_MCP_URL=https://mcp.wheelta.com/mcp
WHEELTA_MCP_TOKEN=                    # [secret] [required] the agent's own label in WHEELTA_HTTP_AUTH_TOKENS on wheelta-mcp

# ── Tavily web search (ADR-0058) ─────────────────────────────────────────────
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=                       # [secret] tvly-… key; unset/blank = Tavily disabled, research Mignons get no web tools (run continues)

# ── Ledger (Railway Postgres) ────────────────────────────────────────────────
DATABASE_URL=                         # [secret] [required] in Railway: ${{Postgres.DATABASE_URL}}
LEDGER_READONLY_URL=                  # [secret] [optional, desktop only, never in Railway] production ledger as the read-only ledger_reader role via the TCP proxy; used only by scripts/*.py --prod (ADR-0067)

# ── Observability ────────────────────────────────────────────────────────────
HEARTBEAT_URL=                        # [secret] status per scheduled invocation (incl. normal skips); monitor the configured cron schedule
ALERT_WEBHOOK_URL=                    # [secret] destination for operational alerts

# ── Run summary email (ADR-0029) ────────────────────────────────────────────
RUN_SUMMARY_EMAIL_ENABLED=false       # one Resend email per run whose agent session started (any outcome); skipped runs never email; true requires RESEND_API_KEY and RUN_SUMMARY_EMAIL_TO
RESEND_API_KEY=                       # [secret] Resend sending-only key, restricted to the wheelta.com domain
RUN_SUMMARY_EMAIL_FROM="Wheelta Agent <agent@wheelta.com>"  # sender; must be on a Resend-verified domain
RUN_SUMMARY_EMAIL_TO=                 # [secret] single recipient address (kept out of logs)
RUN_SUMMARY_MODEL=                    # [optional] exact model ID that writes the summary prose; unset or blank = AGENT_MODEL without any [1m] suffix; aliases rejected
